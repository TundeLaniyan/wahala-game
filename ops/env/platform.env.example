# Copy to ops/env/platform.local.env (git-ignored) and edit. NEVER commit a filled copy. Meanings: player-platform/README.md.
# Validate with:  cd player-platform && npm run check:config
PLATFORM_ENV=development
PLATFORM_DB_PASSWORD=change-me-local-only

# Exact browser origins allowed to call the API (no wildcard). The Vite dev page and the local build:
PLATFORM_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
PLATFORM_PUBLIC_WEB_URL=http://localhost:5173

# Development identity provider: signed TEST tokens through the real verifier. It is NOT Google or Apple. Refused in production.
PLATFORM_MOCK_IDP=1

# Real providers: leave empty until the founder has registered the apps (docs/PLATFORM_PROVIDER_REQUIREMENTS.md).
PLATFORM_GOOGLE_CLIENT_IDS=
PLATFORM_APPLE_CLIENT_IDS=

# Shared secrets (>= 32 chars each, `openssl rand -hex 32`). Empty = that internal surface is OFF.
PLATFORM_MATCH_SERVER_SECRET=
PLATFORM_ADMIN_TOKEN=

# Ed25519 key that signs match-handoff tickets. Empty in development = an ephemeral key per start.
PLATFORM_HANDOFF_PRIVATE_KEY=

# Behind a reverse proxy only: the proxy's address(es), so X-Forwarded-For is believed. Empty = never.
PLATFORM_TRUSTED_PROXIES=

PLATFORM_PARTY_MAX_SIZE=8
# Development-only switches (refused in production): unrestricted-chat dev build, mock checkout (no real payment)
PLATFORM_DEV_TEXT_CHAT=0
PLATFORM_MOCK_CHECKOUT=0

# Automatic one-hour silence of a player's presets after reports from 3 different players. Default: on in development, OFF in production
# until moderators exist (docs/PLATFORM_COLLUSION_ANALYSIS.md).
PLATFORM_AUTO_RESTRICT=
