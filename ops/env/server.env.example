# Game server runtime configuration TEMPLATE. Copy to server.env (git-ignored), fill in, never commit the copy.
# Real values are provided by the host's secret store / `docker compose --env-file`, not by the repository.

# --- required in production ---------------------------------------------------------------------------------------
# Exact browser origins allowed to open a game socket. GitHub Pages serves the game from this ORIGIN (no path part):
RUMBLE_ALLOWED_ORIGINS=https://tundelaniyan.github.io
# Bearer token for GET /metrics. Generate: openssl rand -hex 24   (rotate if it ever appears in a log or chat)
RUMBLE_METRICS_TOKEN=CHANGE_ME_generate_with_openssl_rand_hex_24

# --- optional ----------------------------------------------------------------------------------------------------
# Seconds a dropped player's seat waits for them. The product requirement is 30. Do not lower it for production.
RUMBLE_RECONNECT_SECONDS=30
# PORT=2567
# NODE_ENV=production        (the Dockerfile sets it; production = NO development localhost origins)

# --- NEVER set in production ---------------------------------------------------------------------------------------
# RUMBLE_TEST_FAST=1         test-only: shortens countdowns/matches and accepts odd durations
