# Copy to ops/env/server.local.env (git-ignored) and edit. NEVER commit a filled copy. Nothing here is a secret EXCEPT
# RUMBLE_METRICS_TOKEN. Docs: docs/ops/SECRETS.md. Variable meanings: docs/CITY_RUMBLE_ONLINE_LOCAL.md section 1.
NODE_ENV=production
PORT=2567

# Exact browser origins allowed to open a socket. Production: ONLY these. Include the Pages origin (no path, no trailing slash).
# Laptop/phone testing against a built page: add http://<laptop-lan-ip>:<port>. Not used by non-browser clients (see docs/ops/AUDIT.md F4).
RUMBLE_ALLOWED_ORIGINS=https://tundelaniyan.github.io

# REQUIRED before anything is reachable from outside this machine: /metrics is open to anyone when unset (AUDIT.md F1).
# Generate:  openssl rand -hex 32
RUMBLE_METRICS_TOKEN=

# Locked product requirements (do not change for public play): 5 s grace, 30 s reconnection window, bots take the seat.
RUMBLE_GRACE_SECONDS=5
RUMBLE_RECONNECT_SECONDS=30
RUMBLE_DROP_POLICY=bot
RUMBLE_PING_INTERVAL_MS=3000
RUMBLE_PING_MAX_RETRIES=4
# NEVER set RUMBLE_TEST_FAST in a reachable deployment: it lets clients pick start times and match lengths.

# Client address (decision FU2S-C4). X-Forwarded-For is believed ONLY when the TCP peer is listed here; empty = never.
# Behind ops/compose/compose.edge.yml the peer is the nginx container on the fixed 172.29.0.0/24 network. Leave EMPTY for the
# local (no proxy) stack: a client could otherwise choose its own address.
RUMBLE_TRUSTED_PROXIES=172.29.0.0/24

# Capacity and abuse limits (defaults in server/src/core/limits.ts, explained in docs/ONLINE_LIMITS_AND_SECURITY.md).
# Measured on a shared 4-core box, NOT a quiet host: re-fit RUMBLE_CPU_BUDGET and the room caps on the real machine.
# RUMBLE_MAX_ROOMS=
# RUMBLE_MAX_PLAYING_ROOMS=
# RUMBLE_MAX_CONNECTIONS=
# RUMBLE_CPU_BUDGET=
# RUMBLE_START_WAIT_SEC=
