{
  "name": "wahala-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "WAHALA! - Nigerian-inspired browser arcade game (offline solo vs AI)",
  "scripts": {
    "dev": "vite",
    "dev:online": "node scripts/dev-online.mjs",
    "dev:private": "node scripts/dev-online.mjs --platform",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "simulate": "tsx scripts/simulate.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "combat-balance": "tsx scripts/combat-balance.ts",
    "enemy-balance": "tsx scripts/enemy-balance.ts",
    "enemy-fairness": "tsx scripts/enemy-fairness.ts",
    "combat-pilot": "tsx scripts/combat-pilot.ts",
    "sector-ai": "tsx scripts/sector-ai.ts",
    "boss-audit": "tsx scripts/boss-audit.ts",
    "boss-measure": "tsx scripts/boss-measure.ts",
    "combat-lab-compare": "tsx scripts/combat-lab-compare.ts",
    "streak-measure": "tsx scripts/streak-measure.ts",
    "check:static": "vite build && node scripts/check-static-build.mjs",
    "build:beta": "node scripts/build-beta.mjs",
    "build:online": "WAHALA_ONLINE_ENABLED=true WAHALA_ONLINE_URL='ws://{host}:2567' vite build --outDir dist-online --emptyOutDir",
    "test:online-e2e": "node scripts/online-e2e.mjs",
    "test:private-e2e": "node scripts/private-e2e.mjs",
    "test:beta-e2e": "node scripts/beta-e2e.mjs",
    "beta:tunnel": "node scripts/beta-tunnel.mjs",
    "beta:tunnel:stop": "node scripts/beta-tunnel.mjs stop",
    "beta:tunnel:status": "node scripts/beta-tunnel.mjs status",
    "beta:tunnel:testers": "node scripts/beta-tunnel.mjs testers",
    "beta:tunnel:invite": "node scripts/beta-tunnel.mjs invite",
    "beta:tunnel:logs": "node scripts/beta-tunnel.mjs logs",
    "test:beta-tunnel-e2e": "node scripts/beta-tunnel-e2e.mjs",
    "audio:stage-candidates": "node tools/audio/candidates/stage.mjs",
    "audio:unstage-candidates": "node tools/audio/candidates/stage.mjs --clean",
    "audio:release-build": "node tools/audio/release/build_release.mjs",
    "audio:release-check": "node tools/audio/release/build_release.mjs --check",
    "audio:release-verify": "node tools/audio/release/verify.mjs"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.10",
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
